        function updateAcheteur() {

            const texte = $('#form-warrant option:selected').text();
            const parties = texte.split('-');

            if (parties.length <= 1) {
                $('.type_mandant_2_content').hide();
                return;
            }

            const type_mandant = parties.pop().trim();
            const etape4Active = true;

            if (type_mandant === 'buyers') {

             
                // Le contenu ne s'affiche jamais
                $('.type_mandant_2_content').hide();

            } else {

             

                // Le contenu n'est visible que lorsque l'étape 4 est active
                $('.type_mandant_2_content').toggle(etape4Active);
            }
        }

        $('#form-warrant').on('change', updateAcheteur);
        
        $(document).ready(function () {
            updateAcheteur();
        });



